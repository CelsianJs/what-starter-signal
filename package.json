{
  "name": "what-starter-signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signal is a fictional infrastructure status starter for What Framework and Vura with server-rendered ISR, uncached SSR, and a health API.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vura dev --port 4750",
    "build": "vura build",
    "preview": "NODE_ENV=production PORT=4751 node dist/server/entry.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run test && npm run build && npm run test:browser",
    "deploy:vura": "npm run build && vura-platform deploy",
    "deploy:vura:prod": "npm run build && vura-platform deploy --prod"
  },
  "dependencies": {
    "@celsian/vura-core": "0.8.3",
    "@celsian/vura-cli": "0.8.3",
    "what-framework": "0.13.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "what-compiler": "0.13.10",
    "vura-platform": "0.3.0"
  }
}
